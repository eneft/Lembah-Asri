{
  "name": "lembah-asri-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/repair-red-roof-glb.mjs && node scripts/build-painted-trees.mjs && node scripts/build-character-clips.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/repair-red-roof-glb.mjs && node scripts/build-painted-trees.mjs && node scripts/build-character-clips.mjs",
    "build": "tsc --noEmit && vite build",
    "test:animation": "node --experimental-strip-types --test tests/character-animation.test.mjs",
    "test:materials": "node --experimental-strip-types --test tests/hand-painted-materials.test.mjs",
    "test:farm-browser": "node scripts/check-garden-browser.mjs",
    "test:camera-idle": "node --experimental-strip-types --test tests/camera-idle.test.mjs",
    "pretest:home": "node scripts/repair-red-roof-glb.mjs",
    "test:home": "node --experimental-strip-types --test tests/home-stage.test.mjs tests/garden-farming.test.mjs tests/scene-areas.test.mjs tests/fence-spacing.test.mjs tests/intact-bamboo-fence.test.mjs tests/authored-fence-layout.test.mjs",
    "test:warung": "node --experimental-strip-types --test tests/warung-stage.test.mjs",
    "test:terrain": "node --experimental-strip-types --test tests/terrain-materials.test.mjs",
    "test:terrain-v2": "node --experimental-strip-types --test tests/terrain-v2.test.mjs",
    "test:earth-review": "node --experimental-strip-types --test tests/earth-screenshot-regression.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.17.3",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "1.56.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "id.lembahasri.game",
    "productName": "Lembah Asri",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis", "zip"], "artifactName": "Lembah-Asri-${version}-${arch}.${ext}" }
  }
}