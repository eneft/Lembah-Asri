shader_type spatial;
render_mode depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

// V3: actual 1K hand-painted texture atlas generated by terrain_v3_builder.py.
// One RGB atlas contains four seamlessly repeating 512px biome tiles.
// No obsolete photogrammetry UVs, expensive triplanar sampling or 4K textures.
uniform sampler2D biome_atlas : source_color, filter_linear_mipmap_anisotropic, repeat_disable;
varying vec3 terrain_world;
varying vec3 terrain_normal;

float hash12(vec2 v) {
    return fract(sin(dot(v, vec2(127.1, 311.7))) * 43758.5453);
}

vec2 tile_uv(vec2 world, vec2 tile, float meters_per_tile) {
    vec2 uv = fract(world / meters_per_tile);
    // Keep interpolated texture lookups inside quadrant; eight texel border.
    return tile * 0.5 + vec2(8.0 / 1024.0) + uv * (496.0 / 1024.0);
}

void vertex() {
    terrain_world = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
    terrain_normal = normalize(MODEL_NORMAL_MATRIX * NORMAL);
}

void fragment() {
    float height_m = terrain_world.y;
    float tilt = 1.0 - clamp(abs(terrain_normal.y), 0.0, 1.0);
    float region = hash12(floor(terrain_world.xz / 11.0));
    float soft_shift = (region - 0.5) * 0.36;

    vec2 pos = terrain_world.xz;
    vec3 grass = texture(biome_atlas, tile_uv(pos, vec2(0.0, 0.0), 4.0)).rgb;
    vec3 earth = texture(biome_atlas, tile_uv(pos, vec2(1.0, 0.0), 4.3)).rgb;
    vec3 sand = texture(biome_atlas, tile_uv(pos, vec2(0.0, 1.0), 5.0)).rgb;
    vec3 stone = texture(biome_atlas, tile_uv(pos, vec2(1.0, 1.0), 4.6)).rgb;

    float beach = 1.0 - smoothstep(0.65, 2.35, height_m + soft_shift);
    float soil = smoothstep(0.12, 0.45, tilt) * 0.43;
    float rock = smoothstep(0.35, 0.67, tilt);

    vec3 color = mix(grass, earth, soil);
    color = mix(color, sand, beach);
    color = mix(color, stone, rock * (1.0 - beach * 0.55));
    ALBEDO = color;
    METALLIC = 0.0;
    ROUGHNESS = 0.97;
}
